# API Doctor AI - Environment Variables (Safe Template)
# Copy to .env and fill in values. Never commit .env files.

# Backend
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=25
GEMMA_MAX_RETRIES=2
MAX_BODY_BYTES=2097152
MAX_FINDINGS=250
MAX_TESTS=24
SANDBOX_BUDGET_MS=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_REPOSITORY_URL=https://github.com/Amna503/api-doctor-ai
